# Godot 4+ specific ignores
.godot/
/android/
/tools/engine/
/tests/*_tmp.json

# Local caches, backups, and bundled dependencies
/.qa_userdata/
/.release_smoke/
/backups/
/export_templates/
/tools/downloads/
/tools/authoring/

# Local credentials and environment configuration
.env
.env.*
!.env.example
!.env.sample

# Generated game builds and source bundles
/*.exe
/*.pck
/*.tmp
/*.TMP
/*.zip

# Generated QA captures and logs
/docs/screenshots/
/docs/**/*.png
/docs/**/*.jpg
/docs/**/*.jpeg
/docs/**/*.webp
/docs/**/*.mp4
/docs/**/*.log
